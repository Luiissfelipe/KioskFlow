{
  "name": "kioskflow",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter \"@kioskflow/api...\" --filter \"@kioskflow/web...\" build",
    "dev:api": "pnpm --filter \"@kioskflow/api^...\" build && pnpm --filter @kioskflow/api start:dev",
    "typecheck": "pnpm -r exec tsc --noEmit --incremental",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "depcruise": "depcruise apps/api/src apps/web/src packages --config .dependency-cruiser.cjs",
    "check:fast": "node scripts/check-fast.mjs",
    "check:task": "node scripts/check-task.mjs",
    "check:full": "node scripts/check-full.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  }
}
