{
  "name": "kioskflow",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit --incremental",
    "lint": "eslint --max-warnings 0 .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check:fast": "node scripts/check-fast.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  }
}
